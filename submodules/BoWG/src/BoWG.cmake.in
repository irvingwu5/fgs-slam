# 文件作用：导出 BoWG 库路径、头文件和依赖配置；隶属于构建配置模块。
FIND_LIBRARY(BoWG_LIBRARY BoWG
    PATHS "@CMAKE_INSTALL_PREFIX@/lib"
)

FIND_PATH(BoWG_INCLUDE_DIR BoWG/BoWGDatabase.h
    PATHS "@CMAKE_INSTALL_PREFIX@/include"
)

LIST(APPEND BoWG_INCLUDE_DIR ${BoWG_INCLUDE_DIR})

SET(BoWG_LIBRARIES ${BoWG_LIBRARY})
SET(BoWG_LIBS ${BoWG_LIBRARY})
SET(BoWG_INCLUDE_DIRS ${BoWG_INCLUDE_DIR})
